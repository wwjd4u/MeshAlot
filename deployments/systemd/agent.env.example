# Copy to /etc/meshalot/agent-<existing-identity-owner>.env ONLY during
# a separately approved deployment. Keep this file owned by root, mode 0600.
# All four values are intentionally blank so a missing owner decision fails
# closed rather than silently offering machine resources.
MESHALOT_SERVER_URL=
MESHALOT_IDENTITY_PATH=
MESHALOT_PROVIDER_MODE=
MESHALOT_MANUAL_PAUSE=
